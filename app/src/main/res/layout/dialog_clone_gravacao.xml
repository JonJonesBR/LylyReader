<?xml version="1.0" encoding="utf-8"?>
<!-- Gravação guiada da voz clonada. Rolável inteira para caber em telas pequenas e em paisagem. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/clone_gravacao_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clone_record_guide_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clone_gravacao_dica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clone_record_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/clone_btn_dicas"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/clone_record_tips" />

        <LinearLayout
            android:id="@+id/clone_gravacao_dicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clone_guide_tips_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clone_guide_tip_1"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clone_guide_tip_2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clone_guide_tip_3"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clone_guide_tip_4"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/clone_guide_tip_5"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- O texto-guia rola dentro de uma altura fixa; o texto é selecionável e lido pelo TalkBack. -->
        <ScrollView
            android:id="@+id/clone_guia_rolagem"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clone_guia_altura_max"
            android:layout_marginTop="8dp"
            android:background="?android:attr/colorBackground">

            <TextView
                android:id="@+id/clone_guia_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textIsSelectable="true"
                android:textSize="18sp"
                android:lineSpacingMultiplier="1.2" />
        </ScrollView>

        <TextView
            android:id="@+id/clone_tempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/clone_barra_meta"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="150"
            android:progress="0" />

        <TextView
            android:id="@+id/clone_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/clone_nivel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/clone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clone_btn_cancelar"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/clone_btn_regravar"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/clone_record_redo" />

            <Button
                android:id="@+id/clone_btn_parar"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/clone_record_stop" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
