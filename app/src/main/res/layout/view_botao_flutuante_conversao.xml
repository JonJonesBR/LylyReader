<?xml version="1.0" encoding="utf-8"?>
<!-- Botão flutuante magnético de conversão em andamento: aparece nas telas sem o cartão GerandoAgora. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/botaoFlutuanteConversao"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/color_divider"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/pbBotaoFlutuanteConversao"
            style="?android:attr/progressBarStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="?attr/colorPrimary"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_gerar_audio"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no"/>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
