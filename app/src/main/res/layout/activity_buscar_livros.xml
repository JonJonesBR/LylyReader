<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltarBuscarLivros"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_voltar"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/cd_voltar"
            android:tooltipText="@string/cd_voltar"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/livros_titulo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etBuscaLivro"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/livros_busca_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnBuscarLivro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:minHeight="44dp"
            android:text="@string/livros_buscar"
            android:textSize="13sp"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"/>
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/rgFonteLivro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:singleLine="false">
        <com.google.android.material.chip.Chip
            android:id="@+id/rbFonteGutenberg"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livros_fonte_gutenberg"
            android:checked="true"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/rbFonteWikisource"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livros_fonte_wikisource"
            android:checked="false"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/rbFonteArchive"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livros_fonte_archive"
            android:checked="false"/>
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/rgIdiomaLivro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:singleLine="false">
        <com.google.android.material.chip.Chip
            android:id="@+id/rbIdiomaTodos"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livros_idioma_todos"
            android:checked="true"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/rbIdiomaPt"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PT"
            android:checked="false"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/rbIdiomaEn"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN"
            android:checked="false"/>
        <com.google.android.material.chip.Chip
            android:id="@+id/rbIdiomaEs"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ES"
            android:checked="false"/>
    </com.google.android.material.chip.ChipGroup>

    <Button
        android:id="@+id/btnBaixarTodosLivros"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:text="@string/livros_baixar_todos"
        android:textAllCaps="false"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvStatusLivros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/color_on_surface_dim"
        android:textSize="12sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLivros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"/>

    <Button
        android:id="@+id/btnMaisLivros"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:text="@string/livros_mais"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvAvisoLivros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="@string/livros_aviso"
        android:textColor="@color/color_on_surface_muted"
        android:textSize="11sp"/>
</LinearLayout>
