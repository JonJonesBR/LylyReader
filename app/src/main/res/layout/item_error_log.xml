<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingEnd="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_variant">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvLogSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_on_surface_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnShareLog"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_share"
        app:tint="?attr/colorPrimary"
        android:contentDescription="@string/btn_compartilhar"/>

    <ImageButton
        android:id="@+id/btnDeleteLog"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/color_error"
        android:contentDescription="@string/btn_deletar"/>

</LinearLayout>
