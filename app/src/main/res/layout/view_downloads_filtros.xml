<?xml version="1.0" encoding="utf-8"?>
<!-- Filtros de idioma da aba Downloads: primeira linha da lista, rola junto com ela. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsIdiomaDownloads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIdiomaTodos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/livros_idioma_todos"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIdiomaPt"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_idioma_pt"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIdiomaEn"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_idioma_en"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIdiomaEs"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_idioma_es"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
</FrameLayout>
