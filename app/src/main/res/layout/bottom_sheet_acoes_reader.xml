<?xml version="1.0" encoding="utf-8"?>
<!--
    Menu de ações do leitor: uma lista só, agrupada pelo que se quer fazer (antes eram 3 abas e 19 itens,
    alguns repetidos). O que é raro (editar, limpar, exportar) fica em "Mais opções", fechado por padrão.
    No modo "Ler sem áudio" os grupos de voz e de audiobook somem inteiros.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/color_divider"
        android:backgroundTintMode="src_atop"/>

    <!-- ═══ LEITURA ═══ -->
    <LinearLayout
        android:id="@+id/grupoAcoesLeitura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TituloSecaoAcoes"
            android:text="@string/sheet_section_reading"/>

        <!-- Marcadores e destaques, numa lista só -->
        <LinearLayout
            android:id="@+id/itemAcaoMarcacoes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_bookmark_filled"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/marcacoes_titulo"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Temporizador -->
        <LinearLayout
            android:id="@+id/itemAcaoSleepTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sleep_timer_label"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Aparência -->
        <LinearLayout
            android:id="@+id/itemAcaoAparencia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_paleta"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cd_aparencia"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ═══ VOZ E PRONÚNCIA ═══ -->
    <LinearLayout
        android:id="@+id/grupoAcoesVoz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TituloSecaoAcoes"
            android:text="@string/acoes_secao_voz"/>

        <!-- Voz e velocidade deste livro -->
        <LinearLayout
            android:id="@+id/itemAcaoConfigLivro"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_player_voz"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_config_livro"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Vozes dos personagens -->
        <LinearLayout
            android:id="@+id/itemAcaoVozesPersonagens"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_character_voices"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Dicionário de pronúncias (com sugestão por IA dentro) -->
        <LinearLayout
            android:id="@+id/itemAcaoPronuncia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_dicionario_pronuncia"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ═══ AUDIOBOOK ═══ -->
    <LinearLayout
        android:id="@+id/grupoAcoesAudiobook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TituloSecaoAcoes"
            android:text="@string/acoes_secao_audiobook"/>

        <!-- Gerar audiobook: pergunta livro inteiro ou só o capítulo -->
        <LinearLayout
            android:id="@+id/itemAcaoGerarAudiobook"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_gerar_audiobook"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Ouvir audiobook: só quando o livro já tem MP3 -->
        <LinearLayout
            android:id="@+id/itemAcaoOuvirAudiobook"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_ouvir_audiobook_livro"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider_faint"
        android:layout_marginTop="4dp"/>

    <!-- "Mais opções": cabeçalho que abre e fecha o grupo de texto e arquivo (fechado por padrão) -->
    <LinearLayout
        android:id="@+id/itemAcaoMaisOpcoes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/acoes_mais_opcoes"
            android:textSize="13sp"
            android:textColor="@color/color_on_surface_muted"
            android:textAllCaps="true"
            android:letterSpacing="0.05"/>

        <ImageView
            android:id="@+id/ivAcoesMaisOpcoes"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_capitulo_proximo"
            android:rotation="90"
            app:tint="@color/color_on_surface_muted"
            android:contentDescription="@null"/>

    </LinearLayout>

    <!-- ═══ MAIS OPÇÕES (texto e arquivo) ═══ -->
    <LinearLayout
        android:id="@+id/grupoAcoesMais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Editar texto -->
        <LinearLayout
            android:id="@+id/itemAcaoEditar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scope_edit_text"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Excluir palavra ou frase do livro inteiro -->
        <LinearLayout
            android:id="@+id/itemAcaoExcluirPalavras"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_excluir_ocorrencias"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Refazer limpeza -->
        <LinearLayout
            android:id="@+id/itemAcaoRefazerLimpeza"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scope_redo_cleaning"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Exportar texto: pergunta arquivo único ou um por capítulo -->
        <LinearLayout
            android:id="@+id/itemAcaoExportar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/acao_exportar_texto"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

        <!-- Compartilhar trecho -->
        <LinearLayout
            android:id="@+id/itemAcaoCompartilharTrecho"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_share"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cd_compartilhar_trecho"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:paddingStart="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider_faint"
        android:layout_marginTop="4dp"/>

    <!-- Ajuda: sempre visível, no rodapé -->
    <LinearLayout
        android:id="@+id/itemAcaoAjuda"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_help"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_help_tutorial"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface"
            android:paddingStart="16dp"/>

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
