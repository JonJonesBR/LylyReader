<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- rb-66 (passo 2): o cabeçalho fica por cima do conteúdo (é o 1º filho do Coordinator, para o TalkBack e o
         teclado lerem primeiro). Não empurra o texto: a reserva é o paddingTop de conteudoDoLeitor (TelaCheiaDoLeitor).
         Toolbar, divisor, busca e capítulo ficam neste contêiner. No modo páginas ele some ao virar a página com o
         dedo, e volta com um deslize para baixo. Só a TelaCheiaDoLeitor mexe na visibilidade dele. A ordem do TalkBack
         não segue a árvore (o framework ordena pela posição, e os dois começam no mesmo topo): por isso o
         accessibilityTraversalBefore. -->
    <com.jonjonesbr.audiobookgen.ui.BarraDoLeitor
        android:id="@+id/cabecalhoDoLeitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/color_background"
        android:elevation="4dp"
        android:outlineProvider="none"
        android:importantForAccessibility="yes"
        android:accessibilityTraversalBefore="@+id/conteudoDoLeitor"
        android:orientation="vertical">

        <!-- ── Toolbar (cores do tema de leitura: aplicarPaletaNasBarrasDoLeitor) ── -->
        <LinearLayout
            android:id="@+id/toolbarReader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            android:background="@color/color_background">

            <ImageButton
                android:id="@+id/btnReaderVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_voltar"
                app:tint="@color/color_on_surface_muted"
                android:contentDescription="@string/cd_voltar"
                android:tooltipText="@string/cd_voltar"/>

            <TextView
                android:id="@+id/tvReaderTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"/>

            <!-- Botão de busca -->
            <ImageButton
                android:id="@+id/btnBuscarReader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_buscar"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_buscar"
                android:tooltipText="@string/cd_buscar"/>

            <!-- Botão de bookmark: alterna marcado/desmarcado na posição atual (ícone reflete o estado) -->
            <ImageButton
                android:id="@+id/btnBookmarkReader"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_bookmark_border"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_bookmark"
                android:tooltipText="@string/cd_bookmark"/>

            <!-- Botão de mais opções (abre BottomSheet de ações) -->
            <ImageButton
                android:id="@+id/btnReaderOpcoes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_mais"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_mais_opcoes"
                android:tooltipText="@string/cd_mais_opcoes"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_divider"/>

        <!-- ── Search bar (inicialmente oculta) ───────────────────────── -->
        <LinearLayout
            android:id="@+id/layoutBuscaReader"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:background="@color/color_surface_variant"
            android:visibility="gone">

            <EditText
                android:id="@+id/etBuscaReader"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="@string/busca_hint"
                android:textSize="13sp"
                android:inputType="text"
                android:background="@android:color/transparent"
                android:imeOptions="actionSearch"
                android:maxLines="1"/>

            <TextView
                android:id="@+id/tvBuscaContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/color_on_surface_muted"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone"/>

            <ImageButton
                android:id="@+id/btnBuscaAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_busca_seta_cima"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_busca_anterior"/>

            <ImageButton
                android:id="@+id/btnBuscaProximo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_busca_seta_baixo"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_busca_proximo"/>

            <ImageButton
                android:id="@+id/btnBuscaFechar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_player_fechar"
                android:padding="12dp"
                app:tint="@color/color_on_surface_muted"
                android:contentDescription="@string/cd_busca_fechar"/>

        </LinearLayout>

        <!-- ── Barra do capítulo atual: ‹ "3/42 · Título ▾" › + progresso ──
             Tocar no título abre a lista de capítulos; as setas vão ao anterior/próximo. -->
        <LinearLayout
            android:id="@+id/barraCapitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCapituloAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_capitulo_anterior"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_capitulo_anterior"
                android:tooltipText="@string/cd_capitulo_anterior"/>

            <LinearLayout
                android:id="@+id/areaCapituloAtual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCapituloAtual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_on_surface"
                        tools:text="3/42 · O despertar"/>

                    <ImageView
                        android:id="@+id/ivAbrirCapitulos"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_lista_capitulos"
                        app:tint="@color/color_on_surface_dim"
                        android:importantForAccessibility="no"/>
                </LinearLayout>

                <!-- Progresso rico: % lido + tempo restante no capítulo -->
                <TextView
                    android:id="@+id/tvProgressoLeitura"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/color_on_surface_dim"
                    android:visibility="gone"
                    tools:text="42% · ~8 min restantes no capítulo"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCapituloProximo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_capitulo_proximo"
                app:tint="@color/color_on_surface_dim"
                android:contentDescription="@string/cd_capitulo_proximo"
                android:tooltipText="@string/cd_capitulo_proximo"/>

        </LinearLayout>
    </com.jonjonesbr.audiobookgen.ui.BarraDoLeitor>

    <LinearLayout
        android:id="@+id/conteudoDoLeitor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="yes"
        android:orientation="vertical">

        <!-- ── Status pill (banner de texto otimizado) ────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <include layout="@layout/banner_texto_otimizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ── Barra de modo ativo (Edição / Comparação) ─────────────── -->
        <LinearLayout
            android:id="@+id/layoutBarraModo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvModoAtivo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <Button
                android:id="@+id/btnConcluirModo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/btn_concluir_modo"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- ── Barra de seleção de vários parágrafos (rb-30): N selecionados, Cancelar, Gerar áudio ── -->
        <LinearLayout
            android:id="@+id/layoutBarraSelecao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSelecaoParagrafos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:accessibilityLiveRegion="polite"/>

            <Button
                android:id="@+id/btnSelecaoCancelar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/btn_cancelar"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnSelecaoGerar"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/selecao_gerar_audio"
                android:textSize="13sp"
                app:icon="@drawable/ic_gerar_audio"/>

        </LinearLayout>

        <!-- ── Loading ───────────────────────────────────────────────── -->
        <!-- Carregando: diz o que está acontecendo (abrindo o livro / preparando o texto para a narração) -->
        <LinearLayout
            android:id="@+id/layoutCarregandoReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/readerProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyle"/>

            <TextView
                android:id="@+id/tvCarregandoReader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:gravity="center"
                android:textColor="@color/color_on_surface_muted"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- ── Paragraph list ────────────────────────────────────────── -->
        <!-- Área da lista: a barra da seleção de texto (rb-38) fica sobreposta no topo, sem empurrar o texto. -->
        <FrameLayout
            android:id="@+id/areaDaListaParagrafos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.jonjonesbr.audiobookgen.ui.RecyclerViewParagrafos
                android:id="@+id/recyclerViewParagrafos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="12dp"
                android:paddingBottom="96dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone"/>

            <!-- Erro dentro da área da lista: ocupa a área toda quando a lista some (rb-38). -->
            <!-- ── Erro ──────────────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutReaderErro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    android:contentDescription="@string/cd_warning"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvReaderErro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/color_on_surface_medium"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Refaz a abertura do livro (ex.: falha de leitura passageira); some sozinho quando o texto carrega. -->
                <Button
                    android:id="@+id/btnTentarDeNovo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/acao_tentar_de_novo"
                    android:textSize="13sp"/>

                <Button
                    android:id="@+id/btnConverterAssim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_converter_assim_mesmo"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- ── Barra das ações da seleção de texto (rb-38): aparece com o menu da seleção aberto. ──
                 Cabe na largura da tela (rb-43): cada ação divide a largura, com o ícone em cima e o rótulo
                 embaixo.
                 Sem alinhar pela linha de base: o rótulo de 2 linhas deslocava o botão para fora da barra (rb-61). -->
            <include layout="@layout/barra_selecao_texto"/>

        </FrameLayout>

    </LinearLayout>

    <!-- ── FAB único de conversão (centro-inferior): texto/ícone mudam conforme
         há ou não seleção ativa, em vez de dois FABs separados no mesmo lugar ── -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabConverterPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/fab_converter_principal"
        android:textSize="14sp"
        android:maxLines="2"
        app:icon="@drawable/ic_gerar_audio"
        app:iconTint="?attr/colorOnPrimaryContainer"
        android:visibility="gone"/>

    <!-- ── "Voltar à narração" (modo manual da leitura guiada): mesma ancoragem do FAB de conversão, mas acima da
         barra guiada. A margem inferior é ajustada em código (posicionarFabVoltarNarracao), pois depende da altura da barra. ── -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabVoltarNarracao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/cd_guided_voltar_narracao"
        android:text="@string/guided_voltar_narracao"
        android:textSize="14sp"
        app:icon="@android:drawable/ic_media_play"
        android:visibility="gone"/>

    <!-- ── Guided player bar ─────────────────────────────────────────────── -->
    <include layout="@layout/painel_guiada"/>

    <!-- ── Collapsible mini-player ───────────────────────────────────────── -->
    <include
        layout="@layout/view_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
