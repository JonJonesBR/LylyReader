<?xml version="1.0" encoding="utf-8"?>
<!-- Rolagem horizontal (rb-26a): cada parágrafo é uma página que rola na vertical quando o texto não cabe nela.
     O TextView é o mesmo de item_paragrafo.xml (include), para os pontos que o tratam como item continuarem válidos. -->
<com.jonjonesbr.audiobookgen.ui.PaginaDoParagrafo
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/paginaParagrafo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:nestedScrollingEnabled="false"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <include layout="@layout/item_paragrafo"/>

</com.jonjonesbr.audiobookgen.ui.PaginaDoParagrafo>
