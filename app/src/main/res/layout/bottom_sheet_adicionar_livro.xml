<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bib_adicionar_titulo"
        android:textColor="@color/color_on_surface"
        android:textSize="18sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="@string/bib_adicionar_desc"
        android:textColor="@color/color_on_surface_dim"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/optAdicionarAparelho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_aparelho"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_aparelho_sub"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optAdicionarGratis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_gratis"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_gratis_sub"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optAdicionarLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_link"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_link_sub"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optAdicionarPasta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_pasta"
            android:textColor="@color/color_on_surface"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bib_add_pasta_sub"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
