<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:background="@color/color_surface">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/color_divider"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_capitulos"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textAllCaps="true"
        android:letterSpacing="0.05"/>

    <TextView
        android:id="@+id/tvCapitulosDicaConverter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/capitulos_dica_converter"
        android:textSize="12sp"
        android:textColor="@color/color_on_surface_dim"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone"/>

    <!-- Busca: só aparece em livros com muitos capítulos -->
    <EditText
        android:id="@+id/etBuscaCapitulos"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/busca_capitulos_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:textSize="14sp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCapitulosToc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:scrollbars="vertical"
        android:clipToPadding="false"/>

</LinearLayout>
