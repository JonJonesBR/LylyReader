<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltarBib"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_voltar"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/cd_voltar"
            android:tooltipText="@string/cd_voltar"/>

        <TextView
            android:id="@+id/tvTituloBib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bib_titulo"
            android:textSize="22sp"
            android:textColor="@color/color_on_surface"
            android:layout_marginStart="16dp"/>

        <EditText
            android:id="@+id/etBuscaBib"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/bib_buscar_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="16sp"
            android:visibility="gone"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/btnTemaBib"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_paleta"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/bib_cd_tema"
            android:tooltipText="@string/bib_cd_tema"/>

        <ImageButton
            android:id="@+id/btnBuscarBib"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_buscar"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/bib_cd_buscar"
            android:tooltipText="@string/bib_cd_buscar"/>

        <ImageButton
            android:id="@+id/btnMaisBib"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_mais"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/cd_mais_opcoes"
            android:tooltipText="@string/cd_mais_opcoes"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabsBib"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/color_background"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="@color/color_on_surface_muted"
        app:tabMode="auto"
        app:tabTextAppearance="@style/TextAppearance.Lyly.Aba"
        app:tabPaddingStart="8dp"
        app:tabPaddingEnd="8dp"
        app:tabMinWidth="0dp"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="true">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bib_aba_todos"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bib_aba_lendo"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bib_aba_audio"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bib_aba_baixados"/>
    </com.google.android.material.tabs.TabLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBib"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="88dp"
            android:overScrollMode="never"/>

        <LinearLayout
            android:id="@+id/layoutVazioBib"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvVazioTituloBib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bib_vazio_titulo"
                android:textSize="20sp"
                android:textColor="@color/color_on_surface"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvVazioTextoBib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/bib_vazio_texto"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface_dim"
                android:gravity="center"/>

            <Button
                android:id="@+id/btnExemploBib"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/bib_exemplo_botao"
                android:textAllCaps="false"
                android:visibility="gone"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbBib"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"/>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAdicionarBib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/bib_adicionar"
            android:textColor="?attr/colorOnPrimary"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"/>
    </FrameLayout>

    <include
        layout="@layout/view_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <include layout="@layout/view_barra_navegacao"/>

</LinearLayout>
