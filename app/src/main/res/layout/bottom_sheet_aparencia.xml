<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_aparencia"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface"
        android:layout_marginBottom="20dp"/>

    <!-- Tamanho da fonte -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tamanho_fonte"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarFonte"
            android:contentDescription="@string/label_tamanho_fonte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="24"
            android:progress="8"/>

        <TextView
            android:id="@+id/tvFonteValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="16"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="20sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Espaçamento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_espacamento_linhas"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textSize="16sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarEspacamento"
            android:contentDescription="@string/label_espacamento_linhas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="20"
            android:progress="10"/>

        <TextView
            android:id="@+id/tvEspacamentoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="1.50"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="16sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Tema -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tema"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTemaDoApp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/tema_do_app"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoTemaLeitura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemaClaro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_tema_claro"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemaEscuro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_tema_escuro"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemaSepia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_tema_sepia"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTemaOled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_tema_oled"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Tipografia (fonte) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tipografia"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoFonte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFontePadrao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_fonte_padrao"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFonteSerifada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_fonte_serifada"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFonteDislexia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_fonte_dislexia"
            android:contentDescription="@string/cd_fonte_dislexia"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Espaço entre letras -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_espaco_letras"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoEspacoLetras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoLetrasNormal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_normal"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoLetrasMedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_medio"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoLetrasLargo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_largo"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Espaço entre parágrafos -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_espaco_paragrafos"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoEspacoParagrafos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoParagrafosNormal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_normal"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoParagrafosMedio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_medio"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEspacoParagrafosLargo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_espaco_largo"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Margem horizontal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_margem"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoMargem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMargemEstreita"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_margem_estreita"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMargemMedia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_margem_media"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMargemLarga"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_margem_larga"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Alinhamento do texto (justificado é o padrão) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_alinhamento"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoAlinhamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlinhJustificado"
            style="@style/Widget.Lyly.BotaoAparencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/alinhamento_justificado"
            android:tooltipText="@string/alinhamento_justificado"
            app:icon="@drawable/ic_alinhar_justificado"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlinhEsquerda"
            style="@style/Widget.Lyly.BotaoAparencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/alinhamento_esquerda"
            android:tooltipText="@string/alinhamento_esquerda"
            app:icon="@drawable/ic_alinhar_esquerda"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlinhCentro"
            style="@style/Widget.Lyly.BotaoAparencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/alinhamento_centro"
            android:tooltipText="@string/alinhamento_centro"
            app:icon="@drawable/ic_alinhar_centro"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlinhDireita"
            style="@style/Widget.Lyly.BotaoAparencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/alinhamento_direita"
            android:tooltipText="@string/alinhamento_direita"
            app:icon="@drawable/ic_alinhar_direita"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"/>

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvAlinhamentoDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/alinhamento_justificado_dica"
        android:textColor="@color/color_on_surface_medium"
        android:textSize="12sp"
        android:visibility="gone"/>

    <!-- Rolagem -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_rolagem"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoRolagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRolagemVertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_rolagem_vertical"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRolagemHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_rolagem_horizontal"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Barras de cima (título, capítulos, opções): sempre, recolher pelo tempo ou à mão (rb-66) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_barras_cima"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoBarrasCima"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasCimaSempre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_sempre"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasCimaTempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_tempo"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasCimaMao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_mao"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvBarrasCimaDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/barras_cima_dica_tempo"
        android:textColor="@color/color_on_surface_medium"
        android:textSize="12sp"/>

    <!-- Painel da guiada (embaixo): sempre aberto, recolher pelo tempo ou à mão (rb-66) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_barras_baixo"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoBarrasBaixo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasBaixoSempre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_sempre"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasBaixoTempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_tempo"
            style="@style/Widget.Lyly.BotaoAparencia"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBarrasBaixoMao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_barras_mao"
            style="@style/Widget.Lyly.BotaoAparencia"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/tvBarrasBaixoDica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/barras_baixo_dica_tempo"
        android:textColor="@color/color_on_surface_medium"
        android:textSize="12sp"/>

    <!-- Brilho -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_brilho"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☾"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarBrilho"
            android:contentDescription="@string/label_brilho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"/>

        <TextView
            android:id="@+id/tvBrilhoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="100%"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Tela -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swManterTelaLigada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/reader_manter_tela_ligada"
        android:textSize="14sp"
        android:textColor="@color/color_on_surface"/>

</LinearLayout>

