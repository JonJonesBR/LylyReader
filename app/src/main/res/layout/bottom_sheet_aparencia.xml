<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/color_surface">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_aparencia"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface"
        android:layout_marginBottom="20dp"/>

    <!-- Tamanho da fonte -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tamanho_fonte"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarFonte"
            android:contentDescription="@string/label_tamanho_fonte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="24"
            android:progress="8"/>

        <TextView
            android:id="@+id/tvFonteValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="20sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Espaçamento -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_espacamento_linhas"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textSize="16sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarEspacamento"
            android:contentDescription="@string/label_espacamento_linhas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="20"
            android:progress="10"/>

        <TextView
            android:id="@+id/tvEspacamentoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.50"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textSize="16sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Tema -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tema"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnTemaDoApp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"
        android:text="@string/tema_do_app"
        android:textAllCaps="false"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnTemaClaro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_tema_claro"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnTemaEscuro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_tema_escuro"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnTemaSepia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_tema_sepia"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnTemaOled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/btn_tema_oled"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Tipografia (fonte) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_tipografia"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnFontePadrao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_fonte_padrao"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnFonteSerifada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/btn_fonte_serifada"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Margem horizontal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_margem"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnMargemEstreita"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_margem_estreita"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnMargemMedia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_margem_media"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnMargemLarga"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/btn_margem_larga"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Alinhamento do texto (justificado é o padrão) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_alinhamento"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipsAlinhamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlinhJustificado"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alinhamento_justificado"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlinhEsquerda"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alinhamento_esquerda"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlinhCentro"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alinhamento_centro"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAlinhDireita"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alinhamento_direita"/>
    </com.google.android.material.chip.ChipGroup>

    <!-- Rolagem -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_rolagem"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnRolagemVertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/btn_rolagem_vertical"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <Button
            android:id="@+id/btnRolagemHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:minHeight="48dp"
            android:layout_weight="1"
            android:text="@string/btn_rolagem_horizontal"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>

    <!-- Brilho -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_brilho"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_muted"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☾"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"/>

        <SeekBar
            android:id="@+id/seekBarBrilho"
            android:contentDescription="@string/label_brilho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"/>

        <TextView
            android:id="@+id/tvBrilhoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textSize="14sp"
            android:textColor="@color/color_on_surface_dim"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"/>
    </LinearLayout>

    <!-- Tela -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swManterTelaLigada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/reader_manter_tela_ligada"
        android:textSize="14sp"
        android:textColor="@color/color_on_surface"/>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
