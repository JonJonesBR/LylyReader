<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- Páginas deslizáveis -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOnboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Indicadores de página (dots) -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"/>

    <!-- Botões -->
    <LinearLayout
        android:id="@+id/layoutBotoesOnboarding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPular"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="@string/onboarding_btn_pular"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="14sp"
            android:backgroundTint="@android:color/transparent"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnProximo"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="48dp"
            android:text="@string/onboarding_btn_proximo"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary"/>

    </LinearLayout>

</LinearLayout>
