<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:elevation="8dp"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"/>

    <!-- Indicador de leitura guiada (aparece em outras telas enquanto a leitura roda) -->
    <LinearLayout
        android:id="@+id/guidedIndicatorBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:background="@color/color_surface"
        android:visibility="gone">

        <TextView
            android:id="@+id/guidedIndicatorText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"/>

        <ImageButton
            android:id="@+id/guidedIndicatorPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_botao_tocar"
            android:padding="12dp"
            android:src="@drawable/ic_player_pause"
            app:tint="?attr/colorOnPrimary"
            android:contentDescription="@string/cd_play_pause"
            android:tooltipText="@string/cd_play_pause"/>

        <!-- Encerra a leitura guiada de qualquer tela, sem precisar abrir o leitor. -->
        <ImageButton
            android:id="@+id/guidedIndicatorFechar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/ic_player_fechar"
            app:tint="@color/color_on_surface_muted"
            android:contentDescription="@string/cd_fechar_leitura_guiada"
            android:tooltipText="@string/cd_fechar_leitura_guiada"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/miniPlayerNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"/>

        <ImageButton
            android:id="@+id/miniPlayerPlayPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_botao_tocar"
            android:padding="12dp"
            android:src="@drawable/ic_player_play"
            app:tint="?attr/colorOnPrimary"
            android:contentDescription="@string/cd_play_pause"
            android:tooltipText="@string/cd_play_pause"/>

        <ImageButton
            android:id="@+id/miniPlayerExpandir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:padding="6dp"
            android:src="@android:drawable/arrow_up_float"
            app:tint="@color/color_on_surface_muted"
            android:contentDescription="@string/cd_expandir_player"
            android:tooltipText="@string/cd_expandir_player"/>

        <!-- Fechar sempre visível no canto superior direito — antes ficava só na seção
             expandida, escondido ao lado do soneca (pedido do usuário pra ficar mais fácil
             de achar sem precisar expandir o player primeiro). -->
        <ImageButton
            android:id="@+id/miniPlayerFechar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/ic_player_fechar"
            app:tint="@color/color_on_surface_muted"
            android:contentDescription="@string/cd_fechar_player"
            android:tooltipText="@string/cd_fechar_player"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniPlayerExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/miniPlayerTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="12sp"
            android:textColor="@color/color_on_surface_muted"
            android:text="@string/tempo_inicial"/>

        <SeekBar
            android:id="@+id/miniPlayerSeek"
            android:contentDescription="@string/cd_posicao_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/color_primary"/>

        <!-- Linhas de largura fixa (pesos iguais): nada sai da tela em celular estreito nem
             com a contagem da soneca no botão. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/miniPlayerRecuar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mini_player_recuar"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp"/>

            <ImageButton
                android:id="@+id/miniPlayerPlayPauseGrande"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="14dp"
                android:background="@drawable/bg_botao_tocar"
                android:src="@drawable/ic_player_play"
                app:tint="?attr/colorOnPrimary"
                android:contentDescription="@string/cd_play_pause"
                android:tooltipText="@string/cd_play_pause"/>

            <Button
                android:id="@+id/miniPlayerAvancar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/mini_player_avancar"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/miniPlayerVel075"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:text="@string/mini_player_vel_075"
                android:textColor="@color/color_on_surface"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/miniPlayerVel100"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:text="@string/mini_player_vel_100"
                android:textColor="@color/color_on_surface"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/miniPlayerVel125"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:text="@string/mini_player_vel_125"
                android:textColor="@color/color_on_surface"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/miniPlayerVel150"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:text="@string/mini_player_vel_150"
                android:textColor="@color/color_on_surface"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/miniPlayerVel200"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:maxLines="1"
                android:text="@string/mini_player_vel_200"
                android:textColor="@color/color_on_surface"
                android:textSize="13sp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/miniPlayerSleepTimer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="1"
                android:text="😴"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface"
                android:contentDescription="@string/cd_sleep_timer"/>

            <Button
                android:id="@+id/miniPlayerLerLivro"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="2"
                android:layout_height="wrap_content"
                android:text="@string/mini_player_ler_livro"
                android:textColor="@color/color_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton"/>

            <Button
                android:id="@+id/miniPlayerCapitulos"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:maxLines="2"
                android:layout_height="wrap_content"
                android:text="@string/action_capitulos"
                android:textColor="@color/color_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
