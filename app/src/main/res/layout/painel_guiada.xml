<?xml version="1.0" encoding="utf-8"?>
<!-- Painel da leitura guiada, no pé da tela (incluído em activity_reader.xml). A paisagem tem a versão de
     layout-land/painel_guiada.xml, com os mesmos ids numa linha só (rb-26b, passo 5). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutGuidedPlayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:accessibilityTraversalBefore="@id/recyclerViewParagrafos"
    android:orientation="vertical"
    android:background="@color/color_surface"
    android:elevation="8dp"
    android:padding="8dp"
    android:visibility="gone">

    <View
        android:id="@+id/divisorGuidedPlayer"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"
        android:layout_marginBottom="8dp"/>

    <!-- Linha 1: status + chips de soneca/velocidade/loading (largura variável, pode
         encolher sem empurrar nada pra fora — não compete por espaço com os controles). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="4dp">

        <!-- "Voltar à narração" no modo páginas (rb-26b, passo 4): o chip flutuante cobria o texto e a alça. Fica
             no lugar do status, que some enquanto o botão aparece (ver ReaderTelaController.aplicarFabs). -->
        <!-- Ocupa o mesmo espaço que o status (largura 0dp com peso 1): os chips de passos e de velocidade ficam com
             a largura natural e não quebram em duas linhas (rb-26b, tela pequena com fonte grande). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuidedVoltarNarracao"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/cd_guided_voltar_narracao"
            android:text="@string/guided_voltar_narracao"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:icon="@android:drawable/ic_media_play"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvGuidedStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Leitura Guiada"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:ellipsize="end"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/tvGuidedSoneca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            tools:text="😴"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:contentDescription="@string/cd_sleep_timer"/>

        <TextView
            android:id="@+id/tvGuidedPassos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            tools:text="⚙ 12"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:contentDescription="@string/cd_guided_voz_motor"/>

        <TextView
            android:id="@+id/btnGuidedVelocidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            tools:text="1.0×"
            android:textSize="13sp"
            android:maxLines="1"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_guided_speed"/>

        <ProgressBar
            android:id="@+id/progressGuidedLoading"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Linha 2: controles de reprodução — largura total fixa (~250dp), sempre cabe
         inteira, então btnGuidedClose nunca é empurrado pra fora da tela (achado do
         usuário: acontecia quando a linha 1 crescia com soneca/loading visíveis). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnGuidedVoz"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_player_voz"
            android:padding="12dp"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/fab_voz_desc"
            android:tooltipText="@string/fab_voz_desc"/>

        <ImageButton
            android:id="@+id/btnGuidedPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_player_prev"
            android:padding="12dp"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/cd_guided_anterior"
            android:tooltipText="@string/cd_guided_anterior"/>

        <ImageButton
            android:id="@+id/btnGuidedPlayPause"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_play_arredondado"
            android:src="@drawable/ic_player_play"
            android:padding="15dp"
            app:tint="?attr/colorOnPrimary"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/cd_guided_play"
            android:tooltipText="@string/cd_guided_play"/>

        <ImageButton
            android:id="@+id/btnGuidedNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_player_next"
            android:padding="12dp"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/cd_guided_proximo"
            android:tooltipText="@string/cd_guided_proximo"/>

        <ImageButton
            android:id="@+id/btnGuidedClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_player_fechar"
            android:padding="12dp"
            app:tint="@color/color_on_surface_muted"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/cd_guided_fechar"
            android:tooltipText="@string/cd_guided_fechar"/>

    </LinearLayout>
</LinearLayout>
