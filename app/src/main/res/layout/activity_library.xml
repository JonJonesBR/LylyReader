<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- Cabeçalho (aba raiz: sem seta de voltar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:background="@color/color_background">

        <ImageButton
            android:id="@+id/btnVoltarLibrary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:contentDescription="@string/cd_voltar"/>

        <TextView
            android:id="@+id/tvTituloLibrary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_audiobooks"
            android:textSize="22sp"
            android:textColor="@color/color_on_surface"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Campo da busca: fica no lugar do título quando a lupa abre (ver alternarBusca) -->
        <EditText
            android:id="@+id/etBuscaLibrary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/library_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/color_on_surface"
            android:textSize="16sp"
            android:visibility="gone"
            android:importantForAutofill="no"
            android:contentDescription="@string/library_search_hint"/>

        <ImageButton
            android:id="@+id/btnAjudaLibrary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_ajuda"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/cd_ajuda"
            android:tooltipText="@string/cd_ajuda"/>

        <!-- Lupa: abre o campo de busca no lugar do título (como na Biblioteca); some sem audiobooks (aplicarOrdenacao) -->
        <ImageButton
            android:id="@+id/btnBuscarLibrary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_buscar"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/library_search_hint"
            android:tooltipText="@string/library_search_hint"
            android:visibility="gone"/>

        <!-- Ordenar: some sem audiobooks (aplicarOrdenacao) -->
        <ImageButton
            android:id="@+id/btnOrdenarLibrary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_ordenar"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/bib_ordenar"
            android:tooltipText="@string/bib_ordenar"
            android:visibility="gone"/>

        <!-- ⋮: importar um áudio que já está no aparelho e abrir as conversões (fila) -->
        <ImageButton
            android:id="@+id/btnMaisLibrary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_mais"
            app:tint="@color/color_on_surface_dim"
            android:contentDescription="@string/cd_mais_opcoes"
            android:tooltipText="@string/cd_mais_opcoes"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_divider"/>

    <include layout="@layout/view_cartao_gerando_agora"/>

    <!-- Resumo da biblioteca inteira ("12 audiobooks · 48h 0min · 3 ouvidos até o fim"); some sem audiobooks -->
    <TextView
        android:id="@+id/tvResumoLibrary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textSize="13sp"
        android:textColor="@color/color_on_surface_dim"
        android:visibility="gone"/>

    <!-- Carregando -->
    <ProgressBar
        android:id="@+id/progressBarLibrary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:visibility="gone"/>

    <!-- Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLibrary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:clipToPadding="false"/>

    <!-- Estado vazio -->
    <LinearLayout
        android:id="@+id/layoutVazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

        <ImageView
            android:layout_width="@dimen/vazio_icone"
            android:layout_height="@dimen/vazio_icone"
            android:src="@drawable/ic_empty_audiobooks"
            android:layout_marginBottom="@dimen/vazio_icone_margem"
            android:contentDescription="@null"/>


        <TextView
            android:id="@+id/tvMsgVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/msg_nenhum_audiobook"
            android:textColor="@color/color_on_surface_medium"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSubMsgVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/msg_converta_livro"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="13sp"/>

        <Button
            android:id="@+id/btnEscolherLivroVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lib_vazio_escolher_livro"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnImportarVazio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lib_importar_audio"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnPermissaoVazio"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/library_perm_acao"
            android:textAllCaps="false"
            android:visibility="gone"/>

        </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Collapsible mini-player -->
    <include
        layout="@layout/view_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <include layout="@layout/view_barra_navegacao"/>

</LinearLayout>
