<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gerar_titulo"
        android:textColor="@color/color_on_surface"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/tvGerarLivro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/literata"
        android:textColor="@color/color_on_surface_muted"
        android:textSize="14sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="@drawable/bg_card">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gerar_voz"
                android:textColor="@color/color_on_surface_dim"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/tvGerarVozNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvGerarVozDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface_muted"
                android:textSize="12sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnGerarTrocarVoz"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livro_trocar"
            android:textColor="?attr/colorPrimary"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gerar_velocidade"
            android:textColor="@color/color_on_surface"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvGerarRitmo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekGerarRitmo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="150"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gerar_dica"
        android:textColor="@color/color_on_surface_dim"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvGerarAvisoPersonagens"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gerar_aviso_personagens"
        android:textColor="@color/color_on_surface_dim"
        android:textSize="12sp"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnGerarAgora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/gerar_agora"
        android:textSize="15sp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"/>

    <Button
        android:id="@+id/btnGerarFila"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/gerar_fila"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btnGerarAvancadas"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/gerar_avancadas"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"/>

    <LinearLayout
        android:id="@+id/layoutGerarAvancadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gerar_pasta_titulo"
            android:textColor="@color/color_on_surface_dim"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvGerarPasta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_on_surface"
                android:textSize="15sp"/>

            <Button
                android:id="@+id/btnGerarPasta"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/gerar_escolher"
                android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutGerarEstilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gerar_estilo_titulo"
                android:textColor="@color/color_on_surface_dim"
                android:textSize="12sp"/>

            <Spinner
                android:id="@+id/spinnerGerarEstilo"
                android:layout_width="match_parent"
                android:layout_height="48dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
